generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------

// Server entity satisfies the "multi-server" requirement
model Server {
  id        String   @id @default(uuid())
  name      String
  ipAddress String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panels      Panel[]
  systemStats SystemStats[]
}

// Panel entity satisfies the "multi-panel" requirement
model Panel {
  id              String    @id @default(uuid())
  serverId        String
  name            String
  url             String
  subUrl          String? // Custom domain/URL for subscription links
  version         String? // Reported Xray/panel version (from the node, simulated in demo)
  apiToken        String? // Bearer token for 3x-ui API Token Based Auth
  username        String? // Fallback: username/password auth
  password        String? // Encrypted at the application layer (AES-256)
  authMode        String    @default("token") // token | credentials
  status          String    @default("online")
  panelType       String    @default("3x-ui")
  webBasePath     String?
  apiBaseUrl      String?
  lastSync        DateTime?
  lastOnline      DateTime?
  inboundCount    Int       @default(0)
  clientCount     Int       @default(0)
  backupEnabled   Boolean   @default(false)
  backupFrequency String    @default("daily") // hourly | 6h | 12h | daily
  backupKeepCount Int       @default(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // API Capability Flags (JSON)
  capabilities            Json?     @default("{}") // Generic capability map: { bulkEnable: true, smtp: false, ... }
  apiVersion              String?   // Tracks exactly which API version was last detected
  capabilitySchemaVersion String    @default("1.0") // Tracks version of capabilities schema to enable safe schema migration
  lastCapabilityScan      DateTime? // Timestamp of the last full capability probe
  capabilityHash          String?   // Hash of the resolved capabilities to detect spec changes

  // Legacy Capability Flags (Transitional Migration - do not drop yet)
  capClientsApi           Boolean   @default(false)
  capPagination           Boolean   @default(false)
  capApiToken             Boolean   @default(false)
  capSlimInbounds         Boolean   @default(false)
  capObservatory          Boolean   @default(false)
  capWebsocket            Boolean   @default(false)
  capBulkEnable           Boolean   @default(false)
  capBulkDisable          Boolean   @default(false)
  capBulkExport           Boolean   @default(false)

  server        Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  inbounds      Inbound[]
  syncState     SyncState?
  backups       Backup[]
  incidents     Incident[]
  storeProfiles StoreProfile[]
  provisioningProfiles ProvisioningProfile[]
  clients       Client[]
  metrics       PanelMetric[]
  actionLogs    ActionLog[]
  outboundMetrics OutboundMetric[]
  adminPanelQuotas AdminPanelQuota[]
  adminRechargeOrders AdminRechargeOrder[]
}

model Inbound {
  id             String   @id @default(uuid())
  panelId        String
  panelInboundId Int?     // Numeric ID from 3x-ui panel — required for native client API calls
  tag            String
  remark         String?
  port           Int
  protocol       String
  settings       Json
  streamSettings Json?
  /// 3x-ui node id hosting this inbound (null/0 = local master panel xray)
  nodeId         Int?
  /// Display name of the hosting node from /panel/api/nodes/list (null when local)
  nodeName       String?
  /// Origin node GUID when inbound was synced from a node (#4983); may equal
  /// master panelGuid for local inbounds on newer 3x-ui (filled at API read time)
  originNodeGuid String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  panel       Panel          @relation(fields: [panelId], references: [id], onDelete: Cascade)
  clientInbounds ClientInbound[]
  adminAccess AdminInbound[]

  @@index([panelId, panelInboundId])
  @@index([panelId, port])
}

// ---------------------------------------------------------
// Users & Ownership
// ---------------------------------------------------------

// Provisioning state machine for client lifecycle integrity
enum ProvisioningStatus {
  PENDING  // Created in DB; provisioning in-flight on panel
  ACTIVE   // Provisioned and verified on panel
  FAILED   // Provisioning failed; never became active — never show to users
  DELETED  // Successfully removed from panel (soft-tombstone for audit trail)
}

enum AdminRole {
  SUPER_ADMIN
  RESELLER
}

enum TrafficMode {
  ALLOCATION
  USAGE
}

enum QuotaMode {
  GLOBAL
  PER_PANEL
}

model Admin {
  id               String      @id @default(uuid())
  username         String      @unique
  email            String      @unique
  passwordHash     String
  role             AdminRole   @default(RESELLER)
  balance          Float       @default(0.0)
  trafficMode      TrafficMode @default(ALLOCATION)
  status           String      @default("active") // active | disabled
  expiryTime       BigInt      @default(0)
  maxClients       Int         @default(0)
  permissions      Json?
  portalSettings   Json?       @default("{}")
  totalAssigned    Float       @default(0.0) // All-time assigned traffic
  gracePeriodStart DateTime? // When balance hits zero in USAGE mode
  refundOnDelete   Boolean     @default(true)
  refundOnEdit     Boolean     @default(true)
  unlimitedTraffic Boolean     @default(false)
  quotaMode        QuotaMode   @default(GLOBAL)
  /// Bumped on password change / disable to invalidate outstanding JWTs.
  tokenVersion     Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  clients          Client[]
  trafficPools     TrafficPool[]
  transactions     TrafficTransaction[]
  auditLogs        AuditLog[]
  adminInbounds    AdminInbound[]
  panelQuotas      AdminPanelQuota[]
  domains          Domain[]
  remoteBackups    RemoteBackupTarget[]
  alerts           AlertConfiguration[]
  storeProfile     StoreProfile?
  storeEnabled     Boolean              @default(false)
  productTemplates ProductTemplate[]
  productCategories ProductCategory[]
  provisioningProfiles ProvisioningProfile[]
  storeAddonConnections StoreAddonConnection[]
  storeProducts    StoreProduct[]
  storeCustomers   StoreCustomer[]
  storeCoupons     StoreCoupon[]
  storeIpLimits    StoreIpLimit[]
  clientTemplates  ClientTemplate[]
  clientNamePools  ClientNamePool[]
  storeAddonGrantsGiven    StoreAddonGrant[]      @relation("AddonGranter")
  storeAddonGrantsReceived StoreAddonGrant[]      @relation("AddonGrantee")
  externalClients          ExternalClientRegistry[]
  storeReferralRewards     StoreReferralReward[]
  Brand            Brand[]
  operationQueues  OperationQueue[]
  moduleAssignments AdminModuleAssignment[]
  actionLogs          ActionLog[]
  rechargeOrdersAsBuyer  AdminRechargeOrder[] @relation("RechargeOrderAdmin")
  rechargeOrdersAsTarget AdminRechargeOrder[] @relation("RechargeOrderTarget")
  rechargeOrdersCreated  AdminRechargeOrder[] @relation("RechargeOrderCreated")
}

// Bridging table for Admin <-> Inbound access
model AdminInbound {
  adminId    String
  inboundId  String
  assignedAt DateTime @default(now())

  admin   Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  inbound Inbound @relation(fields: [inboundId], references: [id], onDelete: Cascade)

  @@id([adminId, inboundId])
}

model AdminPanelQuota {
  adminId       String
  panelId       String
  balance       Float    @default(0)
  totalAssigned Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@id([adminId, panelId])
}

// Client entity strictly tied to an Admin for "ownership tracking"
model Client {
  id            String  @id @default(uuid())
  panelId       String
  adminId       String? // Nullable for Orphaned / Native System Clients
  brandId       String?
  email         String  // Removed @unique
  remark        String? // Human-readable display name
  ownerTag      String? // Short label for grouping/filtering (e.g. 'vip', 'trial')
  uuid          String  // Removed @unique
  subId         String? // 3x-ui subId (used for subscription links)
  subToken      String? @unique // Secure generated token for portal proxy
  flow          String? // XTLS Flow (e.g. xtls-rprx-vision)
  /// Protocol-aware envelope: { protocol, protocolVersion, generatedAt, payload }
  connectionExtras Json? @default("{}")
  balanceDeducted Boolean @default(false) // Whether reseller balance was actually deducted for this client
  enable        Boolean @default(true)
  disableReason String? // MANUAL | EXPIRED | TRAFFIC_LIMIT | BALANCE_EXHAUSTED
  isDeleting    Boolean @default(false)

  // Provisioning lifecycle
  provisioningStatus  ProvisioningStatus @default(ACTIVE) // ACTIVE for all existing records; new records start as PENDING
  provisioningError   String?            // Last error detail for FAILED state
  provisionedAt       DateTime?          // Timestamp when ACTIVE was confirmed

  limitIp    Int    @default(0) // 0 = unlimited

  up         BigInt @default(0) // Bytes uploaded
  down       BigInt @default(0) // Bytes downloaded
  total      BigInt @default(0) // Max bytes allowed (0 = unlimited)
  expiryTime BigInt @default(0) // Unix ms timestamp (0 = no expiry)

  createdWithTrafficMode TrafficMode @default(ALLOCATION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin         Admin?               @relation(fields: [adminId], references: [id], onDelete: SetNull)
  panel         Panel                @relation(fields: [panelId], references: [id], onDelete: Cascade)
  brand         Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  inbounds      ClientInbound[]
  transactions  TrafficTransaction[]
  createdOrders StoreOrder[]         @relation("CreatedClient")
  renewedOrders StoreOrder[]         @relation("RenewClient")

  @@unique([panelId, email])
  @@unique([panelId, uuid])
}

// ---------------------------------------------------------

model ClientInbound {
  clientId   String
  inboundId  String
  assignedAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  inbound Inbound @relation(fields: [inboundId], references: [id], onDelete: Cascade)

  @@id([clientId, inboundId])
}

// ---------------------------------------------------------
// Traffic Accounting
// ---------------------------------------------------------

// Used for "Allocation Mode" (pre-purchased data pools)
model TrafficPool {
  id         String   @id @default(uuid())
  adminId    String
  totalLimit BigInt // Total bytes allocated
  used       BigInt   @default(0)
  status     String   @default("active") // active, exhausted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  CREDIT
  DEBIT
  USAGE_CHARGE
}

model TrafficTransaction {
  id               String          @id @default(uuid())
  adminId          String
  clientId         String? // Which client triggered this transaction (nullable for top-ups)
  targetClientUuid String? // Persistent reference to client UUID
  amount           BigInt // Bytes moved (positive = credit, negative = debit)
  type             TransactionType
  action           String? // E.g., 'CLIENT_DELETION_REFUND'
  description      String?
  balanceBefore    Float? // Admin balance before transaction
  balanceAfter     Float? // Admin balance after transaction
  panelId          String? // Per-panel quota bucket when quotaMode=PER_PANEL
  createdAt        DateTime        @default(now())

  admin  Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([targetClientUuid, action])
}

// ---------------------------------------------------------
// Operations & Auditing
// ---------------------------------------------------------

enum OperationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model OperationQueue {
  id          String          @id @default(uuid())
  adminId     String?
  entityId    String?         // E.g. Client UUID
  entityType  String          // 'Client', 'Panel', etc.
  operation   String          // 'DELETE', 'RENEW', 'TRAFFIC_INCREASE', 'EXPIRY_CHANGE', 'RESET_TRAFFIC'
  payload     Json            // The data required for the operation
  status      OperationStatus @default(PENDING)
  attempts    Int             @default(0)
  errorLog    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  admin       Admin?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  action    String
  entity    String // e.g., 'Client', 'Panel', 'TrafficPool'
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
}

model Backup {
  id                 String    @id @default(uuid())
  panelId            String? // Null denotes a global/PostgreSQL backup
  type               String // full | database | config | panel | postgres | x-ui-db
  filePath           String
  fileName           String?
  fileSize           BigInt
  checksum           String? // SHA-256 hash for corruption detection
  tier               String    @default("hourly") // hourly | daily | weekly | monthly | manual
  retentionKey       String? // latest_hour | latest_6h | latest_12h | latest_day | latest_3d | latest_week
  isManual           Boolean   @default(false)
  status             String    @default("completed") // pending | completed | failed | corrupted
  verificationStatus String    @default("pending") // pending | healthy | corrupted | incomplete
  verifiedAt         DateTime?
  version            String?
  createdAt          DateTime  @default(now())

  panel Panel? @relation(fields: [panelId], references: [id], onDelete: SetNull)

  @@index([retentionKey, type])
  @@index([createdAt])
  @@index([status])
}

model BackupSchedule {
  id               String    @id @default(uuid())
  name             String    @default("Default Schedule")
  enabled          Boolean   @default(false)
  frequency        String    @default("daily") // hourly | 6h | 12h | daily | 3d | weekly
  backupTypes      Json      @default("[\"full\"]")
  telegramEnabled  Boolean   @default(false)
  telegramBotToken String?
  telegramChatId   String?
  telegramTypes    Json?
  captionTemplate  String?
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SystemStats {
  id         String   @id @default(uuid())
  serverId   String
  cpuUsage   Float
  ramUsage   Float
  diskUsage  Float
  netUp      BigInt
  netDown    BigInt
  recordedAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model SyncState {
  id           String    @id @default(uuid())
  panelId      String    @unique
  lastSync     DateTime
  lastPolledAt DateTime?
  wsConnected  Boolean   @default(false)
  latencyMs    Int? // Last measured round-trip latency to this panel
  status       String // success | failure | pending | offline
  errorLogs    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String // Stored as JSON string to accommodate complex objects
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Premium Features
// ---------------------------------------------------------

enum DomainType {
  PORTAL
  SUBSCRIPTION
  BRAND
  STORE
}

enum DomainStatus {
  PENDING
  VERIFIED
  SSL_ACTIVE
  SSL_FAILED
  EXPIRED
}

model Domain {
  id        String       @id @default(uuid())
  adminId   String?
  domain    String       @unique
  type      DomainType
  status    DomainStatus @default(PENDING)
  sslMethod String?
  certPath  String?
  keyPath   String?
  errorLogs String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  admin        Admin?        @relation(fields: [adminId], references: [id], onDelete: SetNull)
  storeProfile StoreProfile?
  brand        Brand?        @relation("BrandDomain")
}

model Brand {
  id             String   @id @default(uuid())
  adminId        String   @unique
  name           String
  description    String?
  domainId       String?  @unique
  logo           String? // light-mode logo
  logoDark       String? // dark-mode logo
  favicon        String? // deprecated — kept for legacy rows; prefer logo/logoDark
  theme          String?
  primaryColor   String?
  accentColor    String?
  footerText     String?
  supportEmail   String?
  supportLinks   Json?
  contactMethods Json?
  portalSettings Json?    @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admin   Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  domain  Domain?  @relation("BrandDomain", fields: [domainId], references: [id], onDelete: SetNull)
  clients Client[]
}

model RemoteBackupTarget {
  id        String   @id @default(uuid())
  adminId   String?
  provider  String
  config    Json
  status    String   @default("active")
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AlertConfiguration {
  id         String  @id @default(uuid())
  adminId    String
  type       String
  channels   Json
  thresholds Json?
  enabled    Boolean @default(true)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// Premium Storefront (Order Management System)
// ---------------------------------------------------------

enum StoreOrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  UNDER_REVIEW
  APPROVED
  PROVISIONING
  PROVISION_FAILED
  ACTIVE
  REJECTED
  CANCELLED
  EXPIRED
  RENEWED
}

enum StorePaymentMethod {
  MANUAL_BANK
  WALLET
}

enum StorePaymentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  REFUNDED
}

model StoreProfile {
  id                  String   @id @default(uuid())
  adminId             String   @unique
  slug                String   @unique
  domainId            String?  @unique
  title               String   @default("Premium VPN Store")
  description         String?
  logo                String?
  paymentInstructions String?
  bankName            String?
  bankCardNumber      String?
  bankCardHolder      String?
  bankIban            String?
  bankAccountInfo     String?
  paymentConfig       Json? // { methods: { manual_bank: true }, cards: BankCard[] }
  panelId             String?
  theme               String   @default("modern")
  supportLinks        Json?
  defaultCurrency     String   @default("USD")
  enabled             Boolean  @default(true)
  telegramBotEnabled  Boolean  @default(false)
  telegramBotTokenEnc String?
  telegramBotUsername String?
  telegramWebhookSecret String?
  telegramWelcomeText String?
  telegramAdminChatId String?
  /// Customer-facing Telegram bot UI language: "fa" | "en"
  telegramBotLocale   String   @default("fa")
  /// When true, paid orders auto-provision after autoDeliverDelayMinutes but stay tagged for admin confirm.
  autoDeliverEnabled   Boolean  @default(false)
  autoDeliverDelayMinutes Int   @default(10)
  /// Next sequential order number to issue for this store (stored as StoreOrder.trackingCode).
  nextOrderNumber     Int      @default(1000)
  /// Which subscription URL customers receive: "hmpanel" (/s/…) or "native" (3x-ui /sub/…).
  subscriptionLinkMode String  @default("hmpanel")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  admin  Admin        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  panel  Panel?       @relation(fields: [panelId], references: [id], onDelete: SetNull)
  domain Domain?      @relation(fields: [domainId], references: [id], onDelete: SetNull)
  orders StoreOrder[]
  addonConnections StoreAddonConnection[]
}

model ProductCategory {
  id          String   @id @default(uuid())
  adminId     String
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin    Admin          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  products StoreProduct[]

  @@index([adminId])
}

model ProvisioningProfile {
  id            String   @id @default(uuid())
  adminId       String
  name          String
  description   String?
  /// panel_3xui (default) | eylan | future store plugins
  providerId    String   @default("panel_3xui")
  /// Required for panel_3xui; null for plugin providers (eylan, …)
  panelId       String?
  inboundIds    Json     @default("[]")
  protocol      String?
  settings      Json?
  renewalPolicy Json?
  clientPolicy  Json?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admin     Admin             @relation(fields: [adminId], references: [id], onDelete: Cascade)
  panel     Panel?            @relation(fields: [panelId], references: [id], onDelete: Restrict)
  products  StoreProduct[]
  templates ProductTemplate[]

  @@index([adminId])
  @@index([panelId])
  @@index([providerId])
}

/// External store fulfillment plugin connection (Eylan, future addons).
model StoreAddonConnection {
  id              String    @id @default(uuid())
  adminId         String
  storeId         String
  providerId      String
  enabled         Boolean   @default(false)
  apiBaseUrl      String    @default("")
  apiKeyEnc       String    @default("")
  deliveryDomain  String?
  settings        Json?
  optionsCache    Json?
  optionsCachedAt DateTime?
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  admin Admin        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  store StoreProfile @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([adminId, providerId])
  @@index([storeId])
}

model ProductTemplate {
  id           String   @id @default(uuid())
  adminId      String
  profileId    String?
  name         String
  description  String?
  priceToman   Float?
  priceUsd     Float    @default(0)
  traffic      BigInt
  durationDays Int
  inboundIds   Json?
  locationSet  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admin    Admin                @relation(fields: [adminId], references: [id], onDelete: Cascade)
  profile  ProvisioningProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  products StoreProduct[]

  @@index([adminId])
}

// Reusable username sequence (prefix + start) shared by ClientTemplates
model ClientNamePool {
  id          String   @id @default(uuid())
  adminId     String
  name        String
  prefix      String
  separator   String   @default("-")
  startNumber Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// Quick-create presets used on the Clients page (not store products)
model ClientTemplate {
  id            String   @id @default(uuid())
  adminId       String
  name          String
  description   String?
  namePrefix    String?
  nameSeparator String   @default("-")
  nameStart     Int      @default(1)
  inboundIds    Json
  totalGB       Float    @default(0)
  expiryDays    Int      @default(30)
  limitIp       Int      @default(0)
  flow          String?
  remark        String?
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

/// Super-admin shares an addon (e.g. Eylan) API with a reseller + traffic quota.
model StoreAddonGrant {
  id                 String   @id @default(uuid())
  providerId         String
  granterAdminId     String
  granteeAdminId     String
  enabled            Boolean  @default(true)
  trafficQuotaBytes  BigInt   @default(0)
  maxClients         Int      @default(0)
  allowedScope       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  granter Admin @relation("AddonGranter", fields: [granterAdminId], references: [id], onDelete: Cascade)
  grantee Admin @relation("AddonGrantee", fields: [granteeAdminId], references: [id], onDelete: Cascade)

  @@unique([providerId, granteeAdminId])
  @@index([granterAdminId])
  @@index([granteeAdminId])
}

model ExternalClientRegistry {
  id                    String   @id @default(uuid())
  adminId               String
  providerId            String
  username              String
  remoteUserId          String?
  trafficAllocatedBytes BigInt   @default(0)
  source                String   @default("manual")
  storeOrderId          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, providerId, username])
  @@index([adminId, providerId])
}

model StoreProduct {
  id           String   @id @default(uuid())
  adminId      String
  /// Null for test SKUs (no storefront category)
  categoryId   String?
  profileId    String
  templateId   String?
  name         String
  description  String?
  priceToman   Float?
  priceUsd     Float    @default(0)
  traffic      BigInt
  durationDays Int
  status       String   @default("active")
  badge        String?
  sortOrder    Int      @default(0)
  featured     Boolean  @default(false)
  visible      Boolean  @default(true)
  renewable    Boolean  @default(true)
  maxQuantity  Int      @default(1)
  /// Trial / test SKU — one claim per customer per testCooldownoldownDays
  isTest             Boolean @default(false)
  testCooldownoldownDays Int     @default(30)
  /// Legacy JSON tiers — prefer StoreIpLimit + ipLimitIds
  ipLimitOptions Json? @default("[]")
  /// Selected StoreIpLimit ids for this product
  ipLimitIds     Json? @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admin    Admin                @relation(fields: [adminId], references: [id], onDelete: Cascade)
  category ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  profile  ProvisioningProfile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  template ProductTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  orders   StoreOrder[]

  @@index([adminId])
  @@index([categoryId])
  @@index([profileId])
  @@index([isTest])
}

model StoreCustomer {
  id                String    @id @default(uuid())
  adminId           String
  token             String    @unique
  name              String?
  telegram          String?
  telegramUserId    String?
  telegramUsername  String?
  whatsapp          String?
  email             String?
  status            String    @default("active")
  notes             String?
  notificationPrefs Json?     @default("{}")
  metadata          Json?     @default("{}")
  lastSeenAt        DateTime?
  lastLoginAt       DateTime?
  loginCount        Int       @default(0)
  /// Unique invite code for referral deep-links (t.me/bot?start=ref_CODE)
  referralCode      String?   @unique
  referredById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  admin         Admin                       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  referredBy    StoreCustomer?              @relation("StoreReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     StoreCustomer[]             @relation("StoreReferrals")
  orders        StoreOrder[]
  sessions      StoreCustomerSession[]
  notifications StoreCustomerNotification[]
  activities    StoreCustomerActivity[]
  wallet        StoreWalletAccount?
  couponRedemptions StoreCouponRedemption[]
  walletDeposits StoreWalletDeposit[]
  referralRewardGrants StoreReferralRewardGrant[]

  @@unique([adminId, telegramUserId])
  @@index([adminId])
  @@index([token])
  @@index([telegramUserId])
  @@index([referredById])
  @@index([referralCode])
}

model StoreCustomerSession {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  /// How the session was created: telegram | token | web
  authChannel String   @default("token")
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  customer StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@index([expiresAt])
}

model StoreCustomerNotification {
  id         String    @id @default(uuid())
  customerId String
  type       String
  title      String
  message    String?
  payload    Json?     @default("{}")
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  customer StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([customerId, readAt])
}

model StoreCustomerActivity {
  id         String   @id @default(uuid())
  customerId String
  orderId    String?
  type       String
  title      String
  message    String?
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now())

  customer StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    StoreOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([orderId])
}

model StoreOrder {
  id             String           @id @default(uuid())
  trackingCode   String           @unique
  storeId        String
  productId      String
  customerId     String
  configName     String
  amount         Float
  currency       String           @default("USD")
  status         StoreOrderStatus @default(PENDING_PAYMENT)
  rejectReason   String?
  provisionError String?
  notes          String?
  clientId       String?
  isRenewal      Boolean          @default(false)
  renewClientId  String?
  /// Schedule auto-provision (when store auto-deliver is on).
  autoDeliverAt   DateTime?
  /// True after the system auto-provisioned; admin must still confirm or reject.
  autoDelivered   Boolean          @default(false)
  /// Needs admin final confirm (shown as tag in orders UI).
  pendingReview  Boolean          @default(false)
  /// Snapshot before renewal so reject can reverse traffic/expiry.
  renewSnapshot  Json?
  couponId       String?
  discountAmount Float            @default(0)
  /// Chosen concurrent IP limit for this order (0 / null = unlimited)
  limitIp        Int?
  telegramAdminChatId     String?
  telegramAdminMessageId  Int?
  telegramAdminHasPhoto   Boolean @default(false)
  /// Plugin delivery snapshot: { providerId, username, subUrl, subToken, renewOfOrderId }
  fulfillment    Json?
  /// Snapshot of product.isTest at checkout (survives product archive).
  isTest         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  store       StoreProfile            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     StoreProduct            @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer    StoreCustomer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  client      Client?                 @relation("CreatedClient", fields: [clientId], references: [id], onDelete: SetNull)
  renewClient Client?                 @relation("RenewClient", fields: [renewClientId], references: [id], onDelete: SetNull)
  coupon      StoreCoupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payment     StorePayment?
  timeline    OrderTimelineEvent[]
  activities  StoreCustomerActivity[]
  couponRedemption StoreCouponRedemption?

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([couponId])
}

model StorePayment {
  id           String             @id @default(uuid())
  orderId      String             @unique
  method       StorePaymentMethod @default(MANUAL_BANK)
  status       StorePaymentStatus @default(PENDING)
  amount       Float
  currency     String             @default("USD")
  receiptText  String?
  receiptImage String?
  metadata     Json?
  reviewedAt   DateTime?
  reviewedBy   String?
  rejectReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  order StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderTimelineEvent {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  message   String?
  actor     String?
  metadata  Json?
  createdAt DateTime @default(now())

  order StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model StoreWalletAccount {
  id         String   @id @default(uuid())
  customerId String   @unique
  currency   String   @default("USD")
  balance    Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer StoreCustomer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  entries  StoreWalletLedger[]
}

model StoreWalletLedger {
  id        String   @id @default(uuid())
  accountId String
  type      String // deposit | purchase | refund | adjust
  amount    Float
  balanceAfter Float
  orderId   String?
  depositId String?
  note      String?
  meta      Json?    @default("{}")
  createdAt DateTime @default(now())

  account StoreWalletAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([orderId])
}

model StoreWalletDeposit {
  id           String   @id @default(uuid())
  customerId   String
  adminId      String
  amount       Float
  currency     String   @default("USD")
  status       String   @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  receiptText  String?
  receiptImage String?
  rejectReason String?
  reviewedAt   DateTime?
  reviewedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([adminId, status])
}

model StoreCoupon {
  id              String    @id @default(uuid())
  adminId         String
  code            String
  description     String?
  /// percent | fixed
  discountType    String    @default("percent")
  /// Percent value, or legacy fixed amount (migrated into Usd/Toman)
  discountValue   Float     @default(0)
  discountValueUsd   Float  @default(0)
  discountValueToman Float  @default(0)
  currency        String? // legacy optional
  maxUses         Int?
  maxUsesPerCustomer Int    @default(1)
  usedCount       Int       @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  enabled         Boolean   @default(true)
  /// all | new_customers | min_orders | specific_tokens | min_referrals
  audience        String    @default("all")
  audienceMinOrders Int?
  audienceMinReferrals Int?
  audienceTokens  Json? // string[]
  productIds      Json? // string[] optional scope
  categoryIds     Json?
  /// both | new | renewal
  checkoutKind    String    @default("both")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  admin       Admin                  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  orders      StoreOrder[]
  redemptions StoreCouponRedemption[]
  referralRewardGrants StoreReferralRewardGrant[]

  @@unique([adminId, code])
  @@index([adminId, enabled])
}

/// Auto-issue a unique coupon after N referral joins or purchases.
model StoreReferralReward {
  id                   String   @id @default(uuid())
  adminId              String
  enabled              Boolean  @default(true)
  /// join | purchase
  trigger              String   @default("join")
  minCount             Int      @default(3)
  discountType         String   @default("percent")
  discountValue        Float    @default(10)
  discountValueUsd     Float    @default(0)
  discountValueToman   Float    @default(0)
  productIds           Json?    @default("[]")
  categoryIds          Json?    @default("[]")
  telegramMessage      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  admin  Admin                     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  grants StoreReferralRewardGrant[]

  @@index([adminId, enabled])
}

model StoreReferralRewardGrant {
  id         String   @id @default(uuid())
  rewardId   String
  customerId String
  couponId   String
  createdAt  DateTime @default(now())

  reward   StoreReferralReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  customer StoreCustomer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon   StoreCoupon         @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@unique([rewardId, customerId])
  @@index([customerId])
}

/// Store-wide concurrent IP / user-limit catalog (products multi-select)
model StoreIpLimit {
  id              String   @id @default(uuid())
  adminId         String
  limitIp         Int
  label           String
  priceExtraUsd   Float    @default(0)
  priceExtraToman Float    @default(0)
  sortOrder       Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, limitIp])
  @@index([adminId])
}

model StoreCouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  customerId String
  orderId    String   @unique
  amount     Float
  createdAt  DateTime @default(now())

  coupon   StoreCoupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    StoreOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([customerId])
}

// ---------------------------------------------------------
// XRAY PRO (Operations Center)
// ---------------------------------------------------------

enum IncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  ACTIVE
  OPEN
  ACKNOWLEDGED
  RESOLVED
  ARCHIVED
}

enum PremiumModuleKind {
  PLATFORM
  BUSINESS
}

model PremiumModuleState {
  moduleId  String            @id
  kind      PremiumModuleKind
  enabled   Boolean           @default(false)
  settings  Json              @default("{}")
  updatedAt DateTime          @updatedAt
}

model AdminModuleAssignment {
  id        String   @id @default(uuid())
  adminId   String
  moduleId  String
  enabled   Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, moduleId])
  @@index([moduleId])
}

model Incident {
  id              String           @id @default(uuid())
  panelId         String?
  type            String
  severity        IncidentSeverity
  status          IncidentStatus   @default(ACTIVE)
  details         Json?
  duration        Int?
  rootCauseGuess  String?
  confidence      Int?
  timezone        String?
  recoveryTime    Int?
  affectedUsers   Int?
  metricsSnapshot Json?
  suggestedFix    String?
  acknowledgedAt  DateTime?
  detectedAt      DateTime         @default(now())
  resolvedAt      DateTime?
  archivedAt      DateTime?

  panel  Panel?          @relation(fields: [panelId], references: [id], onDelete: SetNull)
  events IncidentEvent[]
}

model IncidentEvent {
  id         String   @id @default(uuid())
  incidentId String
  event      String
  message    String?
  adminId    String?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model PanelMetric {
  id            String   @id @default(uuid())
  panelId       String
  cpu           Float
  ram           Float
  disk          Float
  netUp         BigInt
  netDown       BigInt
  xrayUp        BigInt
  xrayDown      BigInt
  onlineUsers   Int
  activeClients Int
  load1         Float    @default(0)
  load5         Float    @default(0)
  load15        Float    @default(0)
  uptimeSecs    Int      @default(0)
  xrayState     Json?
  recordedAt    DateTime @default(now())

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId, recordedAt])
  @@index([recordedAt])
}

model ActionLog {
  id         String   @id @default(uuid())
  panelId    String?
  adminId    String?
  action     String
  status     String
  details    Json?
  executedAt DateTime @default(now())

  panel Panel? @relation(fields: [panelId], references: [id], onDelete: SetNull)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
}

model AlertRule {
  id              String    @id @default(uuid())
  name            String
  enabled         Boolean   @default(true)
  conditionType   String
  threshold       Json?
  action          String    @default("NOTIFY_ONLY")
  cooldownMinutes Int       @default(60)
  lastTriggered   DateTime?
  createdAt       DateTime  @default(now())
}

model OutboundMetric {
  id          String   @id @default(uuid())
  panelId     String
  outboundTag String
  status      String
  latency     Int
  packetLoss  Float?
  recordedAt  DateTime @default(now())

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId, recordedAt])
  @@index([outboundTag, recordedAt])
}

// ---------------------------------------------------------
// System Migrations
// ---------------------------------------------------------

model SystemMigration {
  id              String   @id @default(uuid())
  version         String   @unique
  executedAt      DateTime @default(now())
  status          String   // SUCCESS, FAILED
  integrityReport Json?
}

// ---------------------------------------------------------
// Admin recharge store (Premium module: admin-recharge)
// ---------------------------------------------------------

enum AdminRechargeOrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  PROVISIONING
  PROVISION_FAILED
  APPROVED
  REJECTED
  CANCELLED
}

enum AgencyPlanKind {
  TOP_UP
  NEW_AGENCY
  BOTH
}

enum AgencyOrderKind {
  TOP_UP
  NEW_AGENCY
}

model AdminRechargePlanCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans AdminRechargePlan[]
}

model AdminRechargePlan {
  id              String          @id @default(uuid())
  categoryId      String?
  planKind        AgencyPlanKind  @default(TOP_UP)
  name            String
  description     String?
  price           Float
  currency        String          @default("IRT")
  trafficBytes    BigInt          @default(0)
  expiryDays      Int             @default(0)
  maxClientsDelta Int             @default(0)
  adminTemplate   Json?
  sortOrder       Int             @default(0)
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  category AdminRechargePlanCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orders   AdminRechargeOrder[]

  @@index([categoryId, enabled])
}

model AgencyReferralCode {
  id                  String   @id @default(uuid())
  code                String   @unique
  ownerTelegramChatId String?
  ownerAdminId        String?
  referralCount       Int      @default(0)
  totalPurchaseAmount Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  buyerSessions AgencyBuyerSession[]
  orders        AdminRechargeOrder[]

  @@index([ownerTelegramChatId])
}

model AgencyBuyerSession {
  id             String   @id @default(uuid())
  telegramChatId String   @unique
  referralCodeId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  referralCode AgencyReferralCode? @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  orders       AdminRechargeOrder[]
}

model AdminRechargeOrder {
  id                     String                   @id @default(uuid())
  trackingCode           String                   @unique
  orderKind              AgencyOrderKind          @default(TOP_UP)
  adminId                String?
  targetAdminId          String?
  createdAdminId         String?
  planId                 String
  status                 AdminRechargeOrderStatus @default(PENDING_PAYMENT)
  amount                 Float
  currency               String                   @default("IRT")
  trafficBytes           BigInt                   @default(0)
  expiryDays             Int                      @default(0)
  maxClientsDelta        Int                      @default(0)
  panelId                String?
  requestedUsername      String?
  requestedPasswordEnc   String?
  buyerSessionId         String?
  referralCodeId         String?
  provisionError         String?
  telegramAdminMessageId String?
  paymentMethod          String                   @default("manual_bank")
  paymentMeta            Json?
  receiptImage           String?
  receiptText            String?
  reviewedBy             String?
  reviewedAt             DateTime?
  rejectReason           String?
  creditedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  admin        Admin?                 @relation("RechargeOrderAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  targetAdmin  Admin?                 @relation("RechargeOrderTarget", fields: [targetAdminId], references: [id], onDelete: SetNull)
  createdAdmin Admin?                 @relation("RechargeOrderCreated", fields: [createdAdminId], references: [id], onDelete: SetNull)
  plan         AdminRechargePlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  panel        Panel?                 @relation(fields: [panelId], references: [id], onDelete: SetNull)
  buyerSession AgencyBuyerSession?    @relation(fields: [buyerSessionId], references: [id], onDelete: SetNull)
  referralCode AgencyReferralCode?    @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  timeline     AdminRechargeTimeline[]

  @@index([adminId, createdAt])
  @@index([targetAdminId, createdAt])
  @@index([buyerSessionId, createdAt])
  @@index([status, createdAt])
  @@index([orderKind, status])
}

model AdminRechargeTimeline {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  message   String?
  actor     String?
  metadata  Json?
  createdAt DateTime @default(now())

  order AdminRechargeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}
