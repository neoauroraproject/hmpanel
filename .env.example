# ═══════════════════════════════════════════════════════════════════
#  HMray Panel — Environment Variables Reference
#  Copy this file to .env and fill in all required values.
#  Never commit your actual .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# RELEASE MODE (do not change for Community Edition)
# Values: COMMUNITY | PREMIUM
# ─────────────────────────────────────────────────────────────────
RELEASE_MODE=COMMUNITY

# ─────────────────────────────────────────────────────────────────
# DATABASE — PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
# ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://panel_user:CHANGE_ME@postgres:5432/panel_db?schema=public"
POSTGRES_USER=panel_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=panel_db

# ─────────────────────────────────────────────────────────────────
# REDIS — Cache & Queue
# ─────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS

# ─────────────────────────────────────────────────────────────────
# SECURITY — JWT & Encryption
# Generate with: openssl rand -hex 64
# ─────────────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────
# APPLICATION — Ports & URLs
# ─────────────────────────────────────────────────────────────────
BACKEND_PORT=4000
HTTP_PORT=80
HTTPS_PORT=443

# Your domain name (used by nginx and SSL)
DOMAIN=panel.yourdomain.com

# Public API URL (as seen by the browser)
# If behind nginx: https://panel.yourdomain.com/api
# If direct: http://your-server-ip:4000
NEXT_PUBLIC_API_URL=https://panel.yourdomain.com/api

# ─────────────────────────────────────────────────────────────────
# ADMIN — Initial Super Admin Account
# Only used during first installation via install.sh
# ─────────────────────────────────────────────────────────────────
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ─────────────────────────────────────────────────────────────────
# NODE
# ─────────────────────────────────────────────────────────────────
NODE_ENV=production
